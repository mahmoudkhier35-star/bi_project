    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Generate dim_date and loading"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{52FC4412-EC1F-4695-ADD0-46BBE7C35960}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Generate dim_date and loading"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CFF4A78F-5488-4D21-A95B-A28587AEEB27}"
          SQLTask:SqlStatementSource="&#xA;SET LANGUAGE us_english;&#xA;&#xA;DECLARE @StartDate DATE;&#xA;DECLARE @EndDate DATE;&#xA;DECLARE @CurrentDate DATE;&#xA;&#xA;-- Get the first and last order dates&#xA;SELECT&#xA;    @StartDate = MIN(order_date),&#xA;    @EndDate = MAX(order_date)&#xA;FROM dbo.Stg_Orders;&#xA;&#xA;-- Start from the first date&#xA;SET @CurrentDate = @StartDate;&#xA;&#xA;-- Generate dates until we reach the last date&#xA;WHILE @CurrentDate IS NOT NULL&#xA;  AND @CurrentDate &lt;= @EndDate&#xA;BEGIN&#xA;&#xA;    -- Insert the date only if it doesn't already exist&#xA;    IF NOT EXISTS&#xA;    (&#xA;        SELECT 1&#xA;        FROM dbo.Dim_Date&#xA;        WHERE date_key =&#xA;            CONVERT(INT, CONVERT(CHAR(8), @CurrentDate, 112))&#xA;    )&#xA;    BEGIN&#xA;&#xA;        INSERT INTO dbo.Dim_Date&#xA;        (&#xA;            date_key,&#xA;            full_date,&#xA;            year_num,&#xA;            month_num,&#xA;            month_name,&#xA;            month_year,&#xA;            day_of_month,&#xA;            day_of_week,&#xA;            day_name,&#xA;            is_weekend&#xA;        )&#xA;        VALUES&#xA;        (&#xA;            CONVERT(INT, CONVERT(CHAR(8), @CurrentDate, 112)),&#xA;            @CurrentDate,&#xA;            YEAR(@CurrentDate),&#xA;            MONTH(@CurrentDate),&#xA;            DATENAME(MONTH, @CurrentDate),&#xA;            LEFT(DATENAME(MONTH, @CurrentDate), 3)&#xA;                + '-' + CAST(YEAR(@CurrentDate) AS VARCHAR(4)),&#xA;            DAY(@CurrentDate),&#xA;&#xA;            -- Monday = 1, Sunday = 7&#xA;            (DATEDIFF(DAY, '19000101', @CurrentDate) % 7) + 1,&#xA;&#xA;            DATENAME(WEEKDAY, @CurrentDate),&#xA;&#xA;            -- Saturday and Sunday = Weekend&#xA;            CASE&#xA;                WHEN (DATEDIFF(DAY, '19000101', @CurrentDate) % 7) + 1&#xA;                     IN (6, 7)&#xA;                THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        );&#xA;&#xA;    END;&#xA;&#xA;    -- Move to the next day&#xA;    SET @CurrentDate = DATEADD(DAY, 1, @CurrentDate);&#xA;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
