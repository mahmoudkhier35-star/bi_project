          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.Stg_OrderDetails;&#xA;TRUNCATE TABLE dbo.Stg_Orders;&#xA;TRUNCATE TABLE dbo.Stg_PaymentMethods;&#xA;TRUNCATE TABLE dbo.Stg_Products;&#xA;TRUNCATE TABLE dbo.Stg_Customers;&#xA;TRUNCATE TABLE dbo.Stg_Categories;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
